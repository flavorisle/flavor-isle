{
  "description": "Syncs the Square catalog (items, prices, modifiers, sold-out status) to the website menu every 15 minutes.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "square_menu_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSquareCatalog",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync Square menu",
            "description": "Items, sizes & sold-out status"
          }
        }
      }
    ]
  },
  "name": "Square Menu Sync"
}