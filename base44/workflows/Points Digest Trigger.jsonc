{
  "name": "Points Digest Trigger",
  "description": "1st of each month at 10 AM store local: sends live Square Star Rewards member digests and an owner metrics email covering order frequency, channel mix, welcome-back redemption, and reward value against gross sales.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 1 * *",
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null,
      "one_time_date": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "points_digest_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendPointsDigest"
          },
          "then": "end",
          "x-base44": {
            "title": "Send monthly points digest",
            "description": "Send current Square Star Rewards balances and monthly member/profit metrics"
          }
        }
      }
    ]
  }
}