{
  "name": "Birthday Email Trigger",
  "description": "Daily at 10 AM store local: finds customers whose birthday is today, auto-grants 150 loyalty points, and sends a birthday treat email. Capped at 1 birthday email per customer per year.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * *",
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null,
      "one_time_date": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "birthday_email_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendBirthdayEmail"
          },
          "then": "end",
          "x-base44": {
            "title": "Send birthday emails",
            "description": "Find customers with birthdays today, grant 150 points, send birthday treat email"
          }
        }
      }
    ]
  }
}