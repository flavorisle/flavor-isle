{
  "description": "Rebuilds the weekday x hour busyness profile from 90 days of Square orders every night so the landing-page chart reflects typical traffic.",
  "name": "Square Busyness Profile",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 3 * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "square_busyness_profile",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "rebuild_profile": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSquareBusyness",
            "args": {
              "mode": "full"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Rebuild busyness profile",
            "description": "90 days of Square orders"
          }
        }
      }
    ]
  }
}