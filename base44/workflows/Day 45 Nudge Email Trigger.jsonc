{
  "name": "Day 45 Nudge Email Trigger",
  "description": "Daily at 10 AM store local: emails the Day 45 nudge to subscribed customers whose first order was 45 days ago and who have not ordered again. Nothing sends while day45NudgeEmailEnabled (default OFF) is off.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 10 * * *",
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null,
      "one_time_date": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "day45_nudge_email_trigger",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendDay45NudgeEmails"
          },
          "then": "end",
          "x-base44": {
            "title": "Send Day 45 nudge emails",
            "description": "Find 45-day-old first orders with no repeat order and send the nudge email"
          }
        }
      }
    ]
  }
}