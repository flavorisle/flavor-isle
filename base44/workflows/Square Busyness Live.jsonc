{
  "description": "Pulls recent Square orders every 5 minutes to keep the live how-busy-are-we bar on the landing page fresh during an active rush.",
  "name": "Square Busyness Live",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "America/Chicago",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "square_busyness_live",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_live": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncSquareBusyness",
            "args": {
              "mode": "live"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Refresh live busyness",
            "description": "Pulls recent Square orders"
          }
        }
      }
    ]
  }
}