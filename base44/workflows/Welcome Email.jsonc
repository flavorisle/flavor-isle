{
  "name": "Welcome Email",
  "description": "Sends the branded Flavor Isle welcome email when a new account signs up.",
  "trigger": {
    "config": {
      "trigger_type": "app_user_auth",
      "events": [
        "signup"
      ]
    },
    "condition": null
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "welcome_email",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "send_welcome": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendWelcomeEmail",
            "args": {
              "email": "${ .trigger.email }",
              "full_name": "${ .trigger.full_name }",
              "user_id": "${ .trigger.user_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send welcome email",
            "description": "Branded welcome to a new signup"
          }
        }
      }
    ]
  }
}