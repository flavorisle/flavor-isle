{
  "name": "GroupPaymentShare",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string",
      "description": "Parent Order id this per-person split share belongs to."
    },
    "order_number": {
      "type": "string",
      "description": "Parent order number, for admin display."
    },
    "intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent id for this person's share. The Stripe webhook matches group orders by this id (group orders use stripe_session_id 'GROUP' on the parent, so they can't be matched the way single orders are). Empty when the group pays through Square payment links instead."
    },
    "square_checkout_order_id": {
      "type": "string",
      "description": "Square hosted-checkout order backing this person's share when the website's secure payment page is set to the alternate processor. The settle pass matches each share's Square payment against expected_amount, and a short payment fails the share."
    },
    "payment_url": {
      "type": "string",
      "description": "Hosted secure payment page for this person's share, shared on the split-payment screen. Empty for Stripe shares, which pay in the app."
    },
    "person_name": {
      "type": "string",
      "description": "Name of the person paying this share."
    },
    "expected_amount": {
      "type": "number",
      "description": "Expected share amount in USD. The webhook verifies the received amount matches before marking the share succeeded, so an underpayment never settles the parent order."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "canceled",
        "refunded"
      ],
      "default": "pending",
      "description": "Settlement state of this share. pending = intent created, not yet paid; succeeded = paid at the correct amount; failed = payment failed or underpaid; canceled = intent canceled (setup failure or customer abandoned); refunded = charge later refunded. The parent Order is settled only when ALL shares are succeeded."
    },
    "settled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this share last transitioned out of pending."
    }
  },
  "required": [
    "order_id",
    "expected_amount"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}