{
  "name": "GroupPaymentShare",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string",
      "description": "Parent Order id this per-person split share belonged to."
    },
    "order_number": {
      "type": "string",
      "description": "Parent order number, for admin display."
    },
    "intent_id": {
      "type": "string",
      "description": "Stripe PaymentIntent id for this person's share. Empty when the share paid through a hosted payment link instead."
    },
    "square_checkout_order_id": {
      "type": "string",
      "description": "Square hosted-checkout order backing this person's share when the website's secure payment page was set to the alternate processor."
    },
    "payment_url": {
      "type": "string",
      "description": "Hosted secure payment page for this person's share, shared on the split-payment screen."
    },
    "person_name": {
      "type": "string",
      "description": "Name of the person paying this share."
    },
    "expected_amount": {
      "type": "number",
      "description": "Expected share amount in USD."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "succeeded",
        "failed",
        "canceled",
        "refunded"
      ],
      "default": "pending",
      "description": "Settlement state of this share."
    },
    "settled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When this share last transitioned out of pending."
    }
  },
  "required": [
    "order_id",
    "expected_amount"
  ],
  "rls": {
    "create": {
      "data.order_id": "group-ordering-removed"
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "data.order_id": "group-ordering-removed"
    },
    "delete": {
      "data.order_id": "group-ordering-removed"
    }
  }
}