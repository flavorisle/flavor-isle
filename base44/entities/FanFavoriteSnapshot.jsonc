{
  "name": "FanFavoriteSnapshot",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note about this snapshot, e.g. how the ranking was computed."
    },
    "shake_rank": {
      "type": "number"
    },
    "ranked": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "lookback_days": {
      "type": "number"
    },
    "computed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "computed_at"
  ]
}