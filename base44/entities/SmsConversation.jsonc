{
  "name": "SmsConversation",
  "type": "object",
  "properties": {
    "phone_number": {
      "type": "string"
    },
    "conversation_id": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time"
    },
    "message_count": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed"
      ],
      "default": "active"
    }
  },
  "required": [
    "phone_number",
    "conversation_id"
  ]
}