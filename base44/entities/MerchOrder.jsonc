{
  "name": "MerchOrder",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "shipping_address": {
      "type": "object",
      "description": "Recipient address sent to Printful for fulfillment",
      "properties": {
        "name": {
          "type": "string"
        },
        "address1": {
          "type": "string"
        },
        "address2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state_code": {
          "type": "string"
        },
        "country_code": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "shipping": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "stripe_session_id": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "wix",
        "square",
        "stripe",
        "helcim"
      ],
      "description": "Which system took the money for this merch order. 'wix' is Base44 Payments, the primary path (issue #116); 'square' is the alternative hosted page. stripe and helcim are retired values kept so historical orders stay valid. Set from the website's secure payment switch when the order is created."
    },
    "payment_url": {
      "type": "string",
      "description": "The secure payment page this merch order was sent to (our own page on flavor-isle.com for the hosted paths). Kept so a re-opened confirmation can show where the payment was made."
    },
    "square_checkout_order_id": {
      "type": "string",
      "description": "Square hosted-checkout order for this merch order when the website's secure payment page is set to the alternate processor. Payment is verified against it \u2014 to the cent \u2014 before Printful is asked to produce anything."
    },
    "wix_checkout_session_id": {
      "type": "string",
      "description": "Base44 Payments (powered by Wix) checkout session for this merch order \u2014 the join key the provider returns to our webhook (checkoutSession.id === order.checkoutId), recorded when the payment is settled so the charge can always be traced back to this order."
    },
    "wix_order_id": {
      "type": "string",
      "description": "The Base44 Payments order that actually paid this merch order, recorded when the settlement confirms it, so refunds in the provider dashboard can be matched to the right order."
    },
    "helcim_checkout_id": {
      "type": "string",
      "description": "Retired: Helcim hosted-checkout token from before issue #116. Kept so historical merch orders still read correctly."
    },
    "helcim_transaction_id": {
      "type": "string",
      "description": "Retired: the Helcim transaction that paid a historical merch order, kept so a refund of an old order can still be traced."
    },
    "printful_order_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "placed",
        "in_production",
        "fulfilled",
        "shipped",
        "canceled",
        "failed"
      ],
      "default": "pending"
    },
    "status_history": {
      "type": "array",
      "default": [],
      "description": "Timestamped log of every fulfillment_status transition reported by Printful, oldest first. Deduped so a repeated webhook for the same stage is logged once.",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "placed",
              "in_production",
              "fulfilled",
              "shipped",
              "canceled",
              "failed"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "tracking_number": {
      "type": "string"
    },
    "tracking_url": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}