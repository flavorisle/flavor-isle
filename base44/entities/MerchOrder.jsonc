{
  "name": "MerchOrder",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "shipping_address": {
      "type": "object",
      "description": "Recipient address sent to Printful for fulfillment",
      "properties": {
        "name": {
          "type": "string"
        },
        "address1": {
          "type": "string"
        },
        "address2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state_code": {
          "type": "string"
        },
        "country_code": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "email": {
          "type": "string"
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "shipping": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "stripe_session_id": {
      "type": "string"
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "stripe",
        "square"
      ],
      "description": "Which system took the money for this merch order. Empty on historical orders (all of which were the original card path). Set from the website's secure payment switch when the order is created."
    },
    "square_checkout_order_id": {
      "type": "string",
      "description": "Square hosted-checkout order for this merch order when the website's secure payment page is set to the alternate processor. Payment is verified against it \u2014 to the cent \u2014 before Printful is asked to produce anything."
    },
    "printful_order_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "fulfillment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "placed",
        "in_production",
        "fulfilled",
        "shipped",
        "canceled",
        "failed"
      ],
      "default": "pending"
    },
    "status_history": {
      "type": "array",
      "default": [],
      "description": "Timestamped log of every fulfillment_status transition reported by Printful, oldest first. Deduped so a repeated webhook for the same stage is logged once.",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "placed",
              "in_production",
              "fulfilled",
              "shipped",
              "canceled",
              "failed"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "tracking_number": {
      "type": "string"
    },
    "tracking_url": {
      "type": "string"
    }
  },
  "required": [
    "customer_email",
    "items",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}