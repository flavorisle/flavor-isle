{
  "name": "Review",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "text": {
      "type": "string"
    },
    "photo_url": {
      "type": "string"
    },
    "is_approved": {
      "type": "boolean",
      "default": false
    },
    "order_id": {
      "type": "string"
    },
    "menu_item_id": {
      "type": "string",
      "description": "MenuItem id this review is about, when the review targets a specific food item. Null for general visit reviews."
    },
    "menu_item_name": {
      "type": "string",
      "description": "Snapshot of the menu item name being reviewed, for display when the item is hidden or unavailable."
    }
  },
  "required": [
    "customer_name",
    "rating",
    "text"
  ],
  "rls": {
    "create": null,
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}