{
  "name": "AdBanner",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "headline": {
      "type": "string"
    },
    "subtext": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Optional background/side image"
    },
    "cta_label": {
      "type": "string",
      "default": "Order Now"
    },
    "cta_link": {
      "type": "string",
      "default": "/menu"
    },
    "placement": {
      "type": "string",
      "enum": [
        "home",
        "menu",
        "cart",
        "contact"
      ],
      "default": "home",
      "description": "Where the banner shows: home hero area, top of menu, cart/checkout, or the contact & location page"
    },
    "theme": {
      "type": "string",
      "enum": [
        "cherry",
        "navy",
        "yellow"
      ],
      "default": "cherry"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Optional start date (YYYY-MM-DD, store local time). When set, the banner only shows on or after this date."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional end date (YYYY-MM-DD, exclusive). When set, the banner only shows before this date."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "headline",
    "placement"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}