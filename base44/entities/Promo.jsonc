{
  "name": "Promo",
  "type": "object",
  "properties": {
    "badge": {
      "type": "string",
      "description": "Short label shown in the colored pill, e.g. 'Every Day'"
    },
    "badge_color": {
      "type": "string",
      "default": "bg-midnight-cherry",
      "description": "Tailwind background class for the badge pill"
    },
    "emoji": {
      "type": "string",
      "default": "\ud83c\udf54"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "description": "Main description text shown on the card"
    },
    "detail": {
      "type": "string",
      "description": "Extra detail revealed when a guest expands 'See details'"
    },
    "cta_label": {
      "type": "string",
      "default": "Order Now"
    },
    "cta_link": {
      "type": "string",
      "default": "/menu"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "description": "When true and active, this promo is shown in the big featured banner"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Lower numbers appear first on the Promos page"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}