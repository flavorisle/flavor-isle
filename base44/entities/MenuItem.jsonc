{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "Burgers",
        "Chicken",
        "Sides",
        "Shakes",
        "Drinks",
        "Breakfast",
        "Specials"
      ]
    },
    "square_category": {
      "type": "string"
    },
    "display_category": {
      "type": "string",
      "description": "Admin-defined override category; when set the item groups under this name instead of its Square/original category. Used to build custom categories (e.g. unique burger groupings)."
    },
    "image_url": {
      "type": "string"
    },
    "image_position": {
      "type": "string",
      "enum": [
        "top",
        "left",
        "right",
        "background",
        "none"
      ],
      "default": "background",
      "description": "Where the item photo sits on the menu card. 'background' = photo fills the whole tile with overlaid title/price/add (default), 'top' = photo above text, 'left'/'right' = photo beside the text, 'none' = no photo (text-only compact card)."
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_fan_favorite": {
      "type": "boolean",
      "default": false,
      "description": "True for the top 10 most-sold items across online + in-store. Refreshed weekly by the refreshFanFavorites workflow."
    },
    "fan_favorite_rank": {
      "type": "number",
      "description": "Rank 1\u201310 among fan favorites (1 = best seller). Null when not a fan favorite."
    },
    "is_hidden": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "square_item_id": {
      "type": "string"
    },
    "calories": {
      "type": "number"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "selection_type": {
            "type": "string"
          },
          "modifiers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                },
                "sold_out": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "name",
    "price",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}