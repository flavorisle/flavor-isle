{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "no_contact_delivery": {
      "type": "boolean",
      "default": false
    },
    "curbside_address": {
      "type": "string"
    },
    "car_make": {
      "type": "string"
    },
    "car_model": {
      "type": "string"
    },
    "car_color": {
      "type": "string"
    },
    "preferred_communication": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "sms"
      ],
      "default": "email"
    },
    "birthday": {
      "type": "string",
      "format": "date",
      "description": "Customer birthday (YYYY-MM-DD). Used by the birthday email automation to send a free-cone treat each year. Optional \u2014 customers add it from their account page."
    },
    "favorite_order": {
      "type": "string"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "cart": {
      "type": "object",
      "description": "Saved cart for cross-device sync: { cartItems, orderType, groupMode, people, activePersonId, savedAt }. Hydrated only for authenticated users so the same cart follows them across phones, tablets, and desktops."
    },
    "cart_reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last cart-abandonment reminder email was sent. Compared against cart.savedAt so a cart modified after a reminder becomes eligible for another reminder after one more hour."
    }
  },
  "required": [
    "name",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}