{
  "name": "CustomerProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "no_contact_delivery": {
      "type": "boolean",
      "default": false
    },
    "curbside_address": {
      "type": "string"
    },
    "car_make": {
      "type": "string"
    },
    "car_model": {
      "type": "string"
    },
    "car_color": {
      "type": "string"
    },
    "preferred_communication": {
      "type": "string",
      "enum": [
        "email",
        "phone",
        "sms"
      ],
      "default": "email"
    },
    "favorite_order": {
      "type": "string"
    },
    "total_orders": {
      "type": "number",
      "default": 0
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email"
  ]
}