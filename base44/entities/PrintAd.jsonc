{
  "name": "PrintAd",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Staff label on the ads list"
    },
    "layout": {
      "type": "string",
      "enum": [
        "classic",
        "poster"
      ],
      "default": "poster"
    },
    "theme": {
      "type": "string",
      "enum": [
        "cherry",
        "navy",
        "gold"
      ],
      "default": "cherry"
    },
    "kicker": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "title_accent": {
      "type": "string"
    },
    "subhead": {
      "type": "string"
    },
    "subhead_highlight": {
      "type": "string",
      "description": "Phrase inside subhead to print highlighted"
    },
    "body": {
      "type": "string"
    },
    "chips": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "price_line": {
      "type": "string"
    },
    "price_note": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "price": {
            "type": "string"
          },
          "photo": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "one_liners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        }
      }
    },
    "badge_top": {
      "type": "string"
    },
    "badge_bottom": {
      "type": "string"
    },
    "strip_kicker": {
      "type": "string"
    },
    "strip_headline": {
      "type": "string"
    },
    "strip_note": {
      "type": "string"
    },
    "strip_photo_wide": {
      "type": "string"
    },
    "strip_photo_tall": {
      "type": "string"
    },
    "plus_line": {
      "type": "string"
    },
    "cta_headline": {
      "type": "string"
    },
    "cta_url": {
      "type": "string"
    },
    "qr_target": {
      "type": "string"
    },
    "show_qr": {
      "type": "boolean",
      "default": true
    },
    "footer_headline": {
      "type": "string"
    },
    "footer_note": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "layout"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}