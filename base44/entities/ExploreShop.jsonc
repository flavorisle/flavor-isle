{
  "name": "ExploreShop",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "section": {
      "type": "string",
      "enum": [
        "shops",
        "surrounding",
        "flavor",
        "attractions"
      ],
      "default": "shops"
    },
    "tag": {
      "type": "string"
    },
    "copy": {
      "type": "string",
      "maxLength": 400
    },
    "detail": {
      "type": "string",
      "maxLength": 1200
    },
    "photo_url": {
      "type": "string"
    },
    "photo_alt": {
      "type": "string"
    },
    "interior_photo_url": {
      "type": "string"
    },
    "interior_photo_alt": {
      "type": "string"
    },
    "interior_caption": {
      "type": "string"
    },
    "lat": {
      "type": "number"
    },
    "lng": {
      "type": "number"
    },
    "walk_miles": {
      "type": "number"
    },
    "walk_minutes": {
      "type": "number"
    },
    "walk_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "walk_polyline": {
      "type": "string"
    },
    "tile": {
      "type": "string",
      "enum": [
        "photo",
        "mono",
        "monoRed",
        "stripe"
      ],
      "default": "photo"
    },
    "address": {
      "type": "string"
    },
    "maps_query": {
      "type": "string"
    },
    "instagram": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hours": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "cta_label": {
      "type": "string"
    },
    "cta_to": {
      "type": "string"
    },
    "link_label": {
      "type": "string"
    },
    "link_to": {
      "type": "string"
    },
    "distance": {
      "type": "string"
    },
    "anchor_id": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "section"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}