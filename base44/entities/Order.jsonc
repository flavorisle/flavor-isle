{
  "name": "Order",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery",
        "dine_in"
      ]
    },
    "pickup_method": {
      "type": "string",
      "enum": [
        "counter",
        "curbside"
      ],
      "description": "For pickup orders: 'counter' = walk in and pick up at the counter, 'curbside' = we bring it to the car. Chosen by the customer in the cart."
    },
    "order_source": {
      "type": "string",
      "enum": [
        "online",
        "in_store"
      ],
      "default": "online",
      "description": "Where the order originated. 'online' for web/app orders placed through the site; 'in_store' for Square POS orders synced from the register."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "redemption_id": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "table_number": {
      "type": "string"
    },
    "estimated_time": {
      "type": "number",
      "description": "Minutes from order placement until the order is ready"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer wants the order ready. For ASAP orders this is order time + 20 min; for scheduled orders it is the chosen time slot."
    },
    "stripe_session_id": {
      "type": "string"
    },
    "square_order_id": {
      "type": "string"
    },
    "square_sync_claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Atomic claim timestamp used by createSquareOrder to prevent duplicate Square order creation when the Stripe webhook fires both checkout.session.completed and payment_intent.succeeded ~1s apart. Set via updateMany with a null-condition so only one concurrent call can proceed. Cleared on failure or when the real square_order_id is persisted. Stale claims (>5 min old) are cleared by autoSyncUnpushedOrders so crashed syncs can be retried."
    },
    "confirmation_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Atomic claim timestamp used by pushOrderToSquareAndKitchen to prevent duplicate customer confirmation emails ('Order locked in'). Set via updateMany with a null-condition so only one concurrent call can proceed. Cleared on send failure so a retry can send it. Independent from the Square push dedupe so the email fires exactly once even if the Square push was handled by a concurrent call."
    },
    "staff_alert_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Atomic claim timestamp used by pushOrderToSquareAndKitchen to prevent duplicate staff alert emails ('New online order'). Set via updateMany with a null-condition so only one concurrent call can proceed. Cleared on send failure so a retry can send it. Independent from the Square push dedupe so the alert fires exactly once even if the Square push was handled by a concurrent call."
    },
    "rec_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Atomic claim timestamp used by sendOrderRecommendationEmail to prevent duplicate recommendation emails. Set via updateMany with a null-condition so only one concurrent call can proceed. Cleared on send failure so the next workflow run can retry."
    },
    "review_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Atomic claim timestamp used by sendReviewRequestEmail to prevent duplicate review-request emails. Set via updateMany with a null-condition so only one concurrent call can proceed. Cleared on send failure so the next workflow run can retry."
    },
    "payment_url": {
      "type": "string",
      "description": "Square-hosted checkout link generated for orders that are paid after the fact (phone orders taken by Smashie). Stored so staff can re-send or look up the link later."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "loyalty_accrued": {
      "type": "boolean",
      "default": false,
      "description": "Whether Square Star Rewards points have been successfully accrued for this order. Set true by the Stripe webhook after a successful accrual, and by the Square order-status sync's self-healing retry (which first checks the Square loyalty ledger for an existing ACCUMULATE_POINTS event so already-credited orders are never re-accrued)."
    },
    "arrival_details": {
      "type": "object",
      "description": "Curbside arrival info logged when the customer taps 'I'm Here' on the order status page: vehicle, parking zone, special notes (extra ketchup, napkins, etc.), and arrival timestamp.",
      "properties": {
        "arrived_at": {
          "type": "string",
          "format": "date-time"
        },
        "zone": {
          "type": "string"
        },
        "car_color": {
          "type": "string"
        },
        "car_make": {
          "type": "string"
        },
        "car_model": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Customer's special requests at arrival, e.g. extra ketchup packets or napkins."
        }
      }
    }
  },
  "required": [
    "order_type",
    "items",
    "total",
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}