{
  "name": "Order",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery",
        "dine_in"
      ]
    },
    "order_source": {
      "type": "string",
      "enum": [
        "online",
        "in_store"
      ],
      "default": "online",
      "description": "Where the order originated. 'online' for web/app orders placed through the site; 'in_store' for Square POS orders synced from the register."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "redemption_id": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "table_number": {
      "type": "string"
    },
    "estimated_time": {
      "type": "number",
      "description": "Minutes from order placement until the order is ready"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "When the customer wants the order ready. For ASAP orders this is order time + 20 min; for scheduled orders it is the chosen time slot."
    },
    "stripe_session_id": {
      "type": "string"
    },
    "square_order_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "card_online",
        "pay_at_pickup"
      ],
      "description": "How the customer chose to pay a phone/chat order. 'card_online' = Square payment link sent at order time (order stays pending until paid). 'pay_at_pickup' = the order is saved as an open Square ticket, fires to the kitchen immediately, and is paid by cash or card at the counter when the customer arrives."
    },
    "loyalty_accrued": {
      "type": "boolean",
      "default": false,
      "description": "Whether Square Star Rewards points have been successfully accrued for this order. Set true by the Stripe webhook after a successful accrual, and by the Square order-status sync's self-healing retry (which first checks the Square loyalty ledger for an existing ACCUMULATE_POINTS event so already-credited orders are never re-accrued)."
    }
  },
  "required": [
    "order_type",
    "items",
    "total",
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}