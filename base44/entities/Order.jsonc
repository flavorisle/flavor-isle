{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery",
        "dine_in"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "redemption_id": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "table_number": {
      "type": "string"
    },
    "estimated_time": {
      "type": "number"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "square_order_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    }
  },
  "required": [
    "order_type",
    "items",
    "total",
    "customer_name",
    "customer_email"
  ]
}