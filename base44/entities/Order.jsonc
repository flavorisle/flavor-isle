{
  "name": "Order",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery",
        "dine_in"
      ]
    },
    "pickup_method": {
      "type": "string",
      "enum": [
        "counter",
        "curbside"
      ],
      "description": "For pickup orders: counter or curbside."
    },
    "order_source": {
      "type": "string",
      "enum": [
        "online",
        "in_store"
      ],
      "default": "online",
      "description": "Where the order originated."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "happy_hour_discount": {
      "type": "number",
      "default": 0,
      "description": "Happy Hour discount, separate from loyalty discount."
    },
    "redemption_id": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "table_number": {
      "type": "string"
    },
    "estimated_time": {
      "type": "number"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "square_order_id": {
      "type": "string"
    },
    "square_sync_claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "staff_alert_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "rec_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "rec_email_skipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "payment_url": {
      "type": "string"
    },
    "manual_pay_required": {
      "type": "boolean",
      "default": false
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "square",
        "stripe"
      ],
      "description": "Processor selected for a phone/chat payment link; Stripe is staff-selected only."
    },
    "square_payment_link_id": {
      "type": "string"
    },
    "square_checkout_order_id": {
      "type": "string",
      "description": "Square hosted-checkout order; only copied to square_order_id after verified payment."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "loyalty_accrued": {
      "type": "boolean",
      "default": false
    },
    "loyalty_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Customer explicitly opted into Star Rewards during this checkout."
    },
    "direct_web_rewards_v2": {
      "type": "boolean",
      "default": false,
      "description": "Created through web checkout after Star Rewards v2; excludes phone, POS and historical orders from direct-order bonuses."
    },
    "arrival_details": {
      "type": "object",
      "properties": {
        "arrived_at": {
          "type": "string",
          "format": "date-time"
        },
        "zone": {
          "type": "string"
        },
        "car_color": {
          "type": "string"
        },
        "car_make": {
          "type": "string"
        },
        "car_model": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "order_type",
    "items",
    "total",
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}