{
  "name": "Order",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_number": {
      "type": "string"
    },
    "source_call_sid": {
      "type": "string",
      "description": "For phone orders, the id of the call that placed the order. While the phone pipeline hands a call between workers, both can briefly observe the same confirmation; logPhoneOrder returns the existing order for a repeated call id instead of creating a second one."
    },
    "order_type": {
      "type": "string",
      "enum": [
        "pickup",
        "delivery",
        "dine_in"
      ]
    },
    "pickup_method": {
      "type": "string",
      "enum": [
        "counter",
        "curbside"
      ],
      "description": "For pickup orders: counter or curbside."
    },
    "order_source": {
      "type": "string",
      "enum": [
        "online",
        "in_store"
      ],
      "default": "online",
      "description": "Where the order originated."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "preparing",
        "ready",
        "delivered",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "subtotal": {
      "type": "number"
    },
    "tax": {
      "type": "number"
    },
    "delivery_fee": {
      "type": "number"
    },
    "tip": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "happy_hour_discount": {
      "type": "number",
      "default": 0,
      "description": "Happy Hour discount, separate from loyalty discount."
    },
    "bundle_id": {
      "type": "string",
      "description": "Family bundle id when this order came from a bundle (e.g. school-night-lifesaver). Informational only: the bundle's items are normal line items and the saving rides on bundle_discount."
    },
    "bundle_discount": {
      "type": "number",
      "default": 0,
      "description": "Fixed family-bundle discount that brings the bundle's included items down to the bundle price ($37.74 for the School Night Lifesaver); paid extras the customer chose stay outside it. POS-only: never printed on a kitchen ticket."
    },
    "redemption_id": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_id": {
      "type": "string",
      "description": "CustomerProfile id this order belongs to (issue #96, section A). Written when the order is created and by the one-time backfill, matching by normalized phone first and email second; empty when the customer is not in the directory yet, which is what the Customers page counts as unlinked."
    },
    "normalized_phone": {
      "type": "string",
      "description": "customer_phone in +1XXXXXXXXXX form (shared/normalizePhone.ts). The customer directory links an order to a person on this field, so the same customer's history groups together no matter which format their number was typed in."
    },
    "delivery_address": {
      "type": "string"
    },
    "special_instructions": {
      "type": "string"
    },
    "table_number": {
      "type": "string"
    },
    "estimated_time": {
      "type": "number"
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time"
    },
    "stripe_session_id": {
      "type": "string"
    },
    "square_order_id": {
      "type": "string"
    },
    "square_sync_claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "confirmation_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "staff_alert_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "rec_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "rec_email_skipped_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_email_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "review_sms_due_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the post-order Google review text for this order becomes due (completion + 2 hours, moved into the 10 AM\u20138 PM store-local window). Stamped once by processPendingReviewSms so later writes to the order cannot move the send time. Issue #37, step 2."
    },
    "review_sms_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the Google review request text was dispatched for this order. Doubles as the atomic claim that stops two overlapping scanner runs from texting the same order twice. Issue #37, step 2."
    },
    "payment_url": {
      "type": "string"
    },
    "manual_pay_required": {
      "type": "boolean",
      "default": false
    },
    "pay_cash_on_pickup": {
      "type": "boolean",
      "default": false,
      "description": "Phone pickup order confirmed for preparation; collect cash at pickup. This flag is not proof of payment."
    },
    "cash_payment_id": {
      "type": "string",
      "description": "Verified Square cash payment recorded when staff collect cash."
    },
    "payment_provider": {
      "type": "string",
      "enum": [
        "square",
        "wix",
        "stripe",
        "helcim"
      ],
      "description": "Which processor this order pays through online or on the phone: square (in-store forever, our own payment page, and the phone line), wix (the website's Base44 Payments, powered by Wix, hosted checkout \u2014 issue #98), or one of the retired paths kept for historical orders (stripe, helcim). The customer never sees a processor name."
    },
    "square_payment_link_id": {
      "type": "string"
    },
    "square_checkout_order_id": {
      "type": "string",
      "description": "Square hosted-checkout order; only copied to square_order_id after verified payment."
    },
    "wix_checkout_session_id": {
      "type": "string",
      "description": "Base44 Payments (powered by Wix) checkout session for this order \u2014 the join key the provider returns to our webhook (checkoutSession.id === order.checkoutId), recorded when the payment is settled so the charge can always be traced back to this order."
    },
    "wix_order_id": {
      "type": "string",
      "description": "The Base44 Payments (powered by Wix) order that actually paid this order, recorded when the settlement confirms it, so refunds in the provider dashboard can be matched to the right order."
    },
    "helcim_checkout_id": {
      "type": "string",
      "description": "Helcim hosted-checkout session for this order (issue #97). The order is matched back to its Helcim payment by this id and by invoiceNumber, and payment_status only becomes paid once Helcim reports an approved payment for the exact order total."
    },
    "helcim_transaction_id": {
      "type": "string",
      "description": "The Helcim transaction that actually paid this order, recorded when the payment is verified so refunds and cancellations go back through the same transaction."
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    },
    "loyalty_accrued": {
      "type": "boolean",
      "default": false
    },
    "loyalty_opt_in": {
      "type": "boolean",
      "default": false,
      "description": "Customer explicitly opted into Star Rewards during this checkout."
    },
    "direct_web_rewards_v2": {
      "type": "boolean",
      "default": false,
      "description": "Created through web checkout after Star Rewards v2; excludes phone, POS and historical orders from direct-order bonuses."
    },
    "loyalty_second_order_bonus_granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "loyalty_streak_bonus_granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "loyalty_welcome_back_bonus_granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "referral_code": {
      "type": "string",
      "maxLength": 16,
      "description": "Star Rewards referral code this order arrived with (issue #83, Part A), captured from a ?ref= link. The referrer's phone number is decoded from it server-side once the order completes; it is never printed on a ticket."
    },
    "referral_bonus_granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the 50-Star referral bonus was granted to this order's referrer (issue #83, Part A). Once set, the bonus never grants again for this order."
    },
    "arrival_details": {
      "type": "object",
      "properties": {
        "arrived_at": {
          "type": "string",
          "format": "date-time"
        },
        "zone": {
          "type": "string"
        },
        "car_color": {
          "type": "string"
        },
        "car_make": {
          "type": "string"
        },
        "car_model": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "relay_status": {
          "type": "string",
          "enum": [
            "pending",
            "relayed",
            "no_answer",
            "fallback_announced"
          ],
          "description": "Curbside relay call state set by the Insights agent after the two-way store call"
        },
        "relay_employee": {
          "type": "string",
          "description": "Name of the employee who answered the counter phone on the relay call, as they gave it."
        },
        "relay_ready": {
          "type": "boolean",
          "description": "Whether the crew said the order is ready to come out when they answered the relay call."
        },
        "relay_eta_minutes": {
          "type": "number",
          "description": "Minutes the crew said the order still needs, when it was not ready at the time of the relay call."
        },
        "relay_message": {
          "type": "string",
          "maxLength": 300,
          "description": "Short note from the relay call, shown on the order status page when there is no ready flag or ETA to show."
        },
        "relay_at": {
          "type": "string",
          "format": "date-time",
          "description": "When the relay call was started for this arrival."
        }
      }
    },
    "cancel_reason": {
      "type": "string",
      "maxLength": 300,
      "description": "Why the crew cancelled this order, typed into the Cancel Order dialog on the Orders page or the Kitchen board \u2014 or, for a register cancellation, the wording Square records (a refund reason the crew typed at the POS, otherwise 'Cancelled at the register.'). Written by the cancelOrder backend function and by the Square sync's POS-cancellation mirror. When set, the cancellation email quotes it back to the customer as 'What happened: ...', so type it for their eyes."
    },
    "cancellation_email_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cancellation email actually went out to the customer. Stamped only on a successful send by notifyOrderCancelled (the crew's Cancel Order flow and the Square sync's register-cancellation mirror); a refused or failed send leaves it empty. Shown on the order card in Admin \u2192 Orders so the crew can confirm the customer was told."
    },
    "cancellation_sms_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cancellation text actually went out to the customer, gated on the same transactional consent as the other order texts. Stamped only on a successful send by notifyOrderCancelled; a skipped or failed send leaves it empty. Shown on the order card in Admin \u2192 Orders."
    },
    "square_refund_amount": {
      "type": "number",
      "default": 0,
      "description": "Total refunded against this order in Square, in dollars \u2014 a register refund of a single item as well as a full refund. Written only by the Square sync's refund mirror (posOrderCancellation); a Stripe refund never sets it. Shown on the order card in Admin \u2192 Orders. A refund covering the whole order also flips payment_status to refunded, and when it lands while the order is still on the board the order is mirrored as cancelled and the customer is told, exactly as the Cancel Order button would have."
    }
  },
  "required": [
    "order_type",
    "items",
    "total",
    "customer_name",
    "customer_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}