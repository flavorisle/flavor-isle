{
  "name": "SquareSyncLog",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "order_id": {
      "type": "string",
      "description": "The Order id this sync attempt was for"
    },
    "order_number": {
      "type": "string",
      "description": "Order number for display"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "skipped"
      ],
      "description": "Outcome of this Square sync attempt: success (order created in Square), failed (Square API error or exception), skipped (already pushed \u2014 duplicate fulfillment guard)"
    },
    "square_order_id": {
      "type": "string",
      "description": "Square order id returned on success"
    },
    "error_message": {
      "type": "string",
      "description": "Error details when the attempt failed"
    }
  },
  "required": [
    "order_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}