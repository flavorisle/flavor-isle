{
  "name": "NewsPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Headline of the announcement"
    },
    "body": {
      "type": "string",
      "description": "Full announcement text"
    },
    "category": {
      "type": "string",
      "enum": [
        "community_event",
        "diner_update",
        "local_partnership"
      ],
      "default": "diner_update",
      "description": "What kind of news this is"
    },
    "image_url": {
      "type": "string",
      "description": "Legacy single photo, shown at the end of the post. New posts use the media list instead."
    },
    "media": {
      "type": "array",
      "description": "Photos and videos attached to the post, each with its own placement: top (above the headline), middle (between the body paragraphs), or bottom (after the text). A post can carry up to one of each.",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public URL of the uploaded photo or video"
          },
          "kind": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ],
            "default": "image",
            "description": "Whether this attachment is a still photo or a video"
          },
          "placement": {
            "type": "string",
            "enum": [
              "top",
              "middle",
              "bottom"
            ],
            "default": "top",
            "description": "Where the attachment sits relative to the post text"
          },
          "caption": {
            "type": "string",
            "description": "Optional caption shown under the photo or video"
          }
        },
        "required": [
          "url",
          "placement"
        ]
      },
      "default": []
    },
    "post_date": {
      "type": "string",
      "format": "date-time",
      "description": "Optional published-on date shown on the card and used for sort order. When set, the card displays this instead of the record's created_date so historical/backdated posts can appear on their intended day. Falls back to created_date when unset."
    },
    "is_published": {
      "type": "boolean",
      "default": true,
      "description": "Only published posts show on the public news page"
    },
    "map_header": {
      "type": "boolean",
      "default": false,
      "description": "When true, the post card opens with the Stops & Shops walking-map header (Smiths Grove, Exit 38, the numbered 1-14 stops line, and the park-once caption) above the post's title."
    }
  },
  "required": [
    "title",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}