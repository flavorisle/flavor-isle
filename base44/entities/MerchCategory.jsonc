{
  "name": "MerchCategory",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Display name of this category or super category."
    },
    "super_category": {
      "type": "string",
      "description": "Parent super category name. When empty/null this record is itself a top-level super category; otherwise it is a sub-category grouped under the named super category."
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Lower numbers appear first within their level."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}