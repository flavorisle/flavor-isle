{
  "name": "GroupOrder",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "Random, unguessable code that is the group's share link. Created once by createGroupOrder and never reused."
    },
    "kind": {
      "type": "string",
      "enum": [
        "group",
        "date_night"
      ],
      "enumColors": [
        "blue",
        "pink"
      ],
      "default": "group",
      "description": "group = a shared group order (issue #356); date_night = the Date Night for Two flow (issue #357), which is the same one-ticket, one-payment group with two named people, a 24-hour invite and 'arriving separately' on the kitchen ticket."
    },
    "host_name": {
      "type": "string",
      "description": "First name of the person who started the group."
    },
    "partner_name": {
      "type": "string",
      "description": "Date Night only: the second person's first name, the one who fills in their picks from the invite. Both first names print on the kitchen ticket."
    },
    "title": {
      "type": "string",
      "description": "What the group is called, e.g. 'Friday lunch crew'. A date night carries both first names here too."
    },
    "closes_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the group stops taking items. After this moment the lines lock and an unpaid group is not placed. A date night is created 24 hours out, so its invite dies a day after it is sent."
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "paid",
        "cancelled"
      ],
      "enumColors": [
        "green",
        "yellow",
        "blue",
        "red"
      ],
      "default": "open",
      "description": "open = taking items; closed = the close time passed and the lines are locked; paid = the whole ticket was paid in full; cancelled = dropped by the store."
    },
    "order_id": {
      "type": "string",
      "description": "The single pickup Order this group produced. Written only when the payment succeeds, never before."
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the whole ticket was paid."
    },
    "paid_by_name": {
      "type": "string",
      "description": "First name of the person who paid for the group. Shown to the group once the ticket is paid."
    }
  },
  "required": [
    "code",
    "host_name",
    "closes_at",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}