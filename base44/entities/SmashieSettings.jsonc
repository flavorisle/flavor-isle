{
  "name": "SmashieSettings",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "greeting": {
      "type": "string",
      "default": "Hey fam, Flavor Isle\u2014Smashie here. What can I get started for you?",
      "description": "Fallback SMS reply when Smashie cannot answer."
    },
    "phone_intro": {
      "type": "string",
      "default": "",
      "description": "Editable open-hours phone introduction after Smashie's name and current busyness. Leave blank for the standard introduction."
    },
    "capabilities": {
      "type": "object",
      "description": "Per-ability phone controls. Missing keys default to enabled.",
      "properties": {
        "orders": {
          "type": "boolean",
          "default": true
        },
        "menu": {
          "type": "boolean",
          "default": true
        },
        "hours": {
          "type": "boolean",
          "default": true
        },
        "wait": {
          "type": "boolean",
          "default": true
        },
        "history": {
          "type": "boolean",
          "default": true
        },
        "directions": {
          "type": "boolean",
          "default": true
        },
        "messages": {
          "type": "boolean",
          "default": true
        },
        "transfer": {
          "type": "boolean",
          "default": true
        }
      },
      "default": {}
    },
    "knowledge_topics": {
      "type": "array",
      "description": "Admin-authored factual answers for Smashie's phone conversations; menu, prices, hours and live conditions always use their live sources.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "default": []
    },
    "sms_status_updates_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, customers receive automated SMS as their order moves through confirmed \u2192 preparing \u2192 ready \u2192 completed"
    },
    "sms_auto_reply_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, incoming SMS texts are answered automatically by Smashie"
    },
    "voice_ordering_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, inbound voice calls are handled by the Smashie AI voice agent"
    },
    "realtime_sip_enabled": {
      "type": "boolean",
      "default": false,
      "description": "When true, inbound calls arriving over the OpenAI SIP trunk are handled by the Live phone pipeline (sub-second turns). Off by default: the Twilio line keeps answering calls through the existing voice webhook until the SIP trunk is pointed at this app and a test call has passed."
    },
    "sip_transfer_target": {
      "type": "string",
      "default": "",
      "description": "Counter-transfer destination for the Live (SIP) phone pipeline \u2014 the Twilio SIP address Smashie hands a caller to on a counter transfer. A plain routing address (sip:counter@<subdomain>.sip.twilio.com), not a phone number. Editable from Admin \u2192 Communications so the address is visible to the crew; the SIP_TRANSFER_TARGET secret is used only as a fallback when this field is blank."
    },
    "personality_notes": {
      "type": "string",
      "default": "",
      "description": "Admin notes about Smashie's persona, tone, or things to emphasize"
    },
    "facebook_access_token": {
      "type": "string",
      "default": "",
      "description": "Meta Conversions API access token. Stored here instead of as a platform secret because the token exceeds Cloudflare's 5.1 kB environment-variable limit, which blocks all function deployments. Read at runtime by facebookConversions.ts."
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}