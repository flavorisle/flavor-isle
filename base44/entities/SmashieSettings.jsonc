{
  "name": "SmashieSettings",
  "type": "object",
  "properties": {
    "greeting": {
      "type": "string",
      "default": "Yo fam, thanks for calling Flavor Isle! Real talk, our crew's slammed helping folks right now, but I got you. I'm Smashie, your AI homie. I can take your order, answer questions about the menu, give directions, or pass a message to the team \u2014 what can I do for you today?",
      "description": "Smashie's default spoken/written greeting used on voice calls and SMS replies. Flow: let the caller know the crew is busy helping customers, introduce yourself as Smashie, then say what you can do for them."
    },
    "sms_status_updates_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, customers receive automated SMS as their order moves through confirmed \u2192 preparing \u2192 ready \u2192 completed"
    },
    "sms_auto_reply_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, incoming SMS texts are answered automatically by Smashie"
    },
    "voice_ordering_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When true, inbound voice calls are handled by the Smashie AI voice agent"
    },
    "personality_notes": {
      "type": "string",
      "default": "",
      "description": "Admin notes about Smashie's persona, tone, or things to emphasize"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}