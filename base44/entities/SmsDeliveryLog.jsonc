{
  "name": "SmsDeliveryLog",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "milestone": {
      "type": "string",
      "enum": [
        "confirmed",
        "preparing",
        "ready",
        "completed",
        "review_request",
        "cancelled"
      ],
      "description": "Which customer text this is. review_request is the post-order Google review ask (issue #37, step 2) and doubles as its 90-day per-phone frequency cap. cancelled is the order-cancellation notice sent by the cancelOrder backend function, gated on the same transactional consent as the other order texts."
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "email_fallback": {
      "type": "string",
      "enum": [
        "sending",
        "sent",
        "failed",
        "skipped"
      ],
      "description": "Whether the milestone EMAIL went out in place of the text (Nov 4 2026 fallback). sending is the pre-send claim that stops two callers emailing the same milestone; sent means the email was delivered; failed means the email could not be sent; skipped means no email was attempted (no customer email, placeholder address, in-store order, or the milestone email already went out for this order). This row stays the record of the TEXT outcome; this flag records the email beside it."
    },
    "email_fallback_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the email fallback was claimed or last updated."
    },
    "email_fallback_note": {
      "type": "string",
      "description": "Human-readable note about the email fallback, e.g. 'Status email sent instead of a text' or the reason it was skipped."
    }
  },
  "required": [
    "order_id",
    "milestone",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}