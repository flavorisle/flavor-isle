{
  "name": "SmsDeliveryLog",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string"
    },
    "order_number": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "milestone": {
      "type": "string",
      "enum": [
        "confirmed",
        "preparing",
        "ready",
        "completed",
        "review_request",
        "cancelled",
        "item_refund"
      ],
      "description": "Which customer text this is. review_request is the post-order Google review ask (issue #37, step 2) and doubles as its 90-day per-phone frequency cap. cancelled is the order-cancellation notice sent by the cancelOrder backend function, gated on the same transactional consent as the other order texts. item_refund is the item-level refund notice written by shared/itemRefund.ts."
    },
    "body": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "description": "Why the text was skipped or failed \u2014 no customer phone, texts switched off, consent missing, Twilio credentials missing, or Twilio's own delivery error message. Read back on the admin Order Status Texts list so the crew can see why a customer never got a text."
    },
    "status_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the row's status last changed (created, queued, sent, delivered, undelivered, failed, skipped). The admin Order Status Texts list sorts by this field, falling back to created_date on older rows that never got one."
    },
    "message_sid": {
      "type": "string",
      "description": "Twilio message SID for the text, written by the send and the delivery-status callback. Matching the callback back to its row is how a delivery update lands on the right order."
    },
    "error_code": {
      "type": "string",
      "description": "Twilio's error code when the carrier refused or the text could not be delivered, as reported by the delivery-status callback."
    },
    "email_fallback": {
      "type": "string",
      "enum": [
        "sending",
        "sent",
        "failed",
        "skipped"
      ],
      "description": "Whether the milestone EMAIL went out in place of the text (Nov 4 2026 fallback). sending is the pre-send claim that stops two callers emailing the same milestone; sent means the email was delivered; failed means the email could not be sent; skipped means no email was attempted (no customer email, placeholder address, in-store order, or the milestone email already went out for this order). This row stays the record of the TEXT outcome; this flag records the email beside it."
    },
    "email_fallback_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the email fallback was claimed or last updated."
    },
    "email_fallback_note": {
      "type": "string",
      "description": "Human-readable note about the email fallback, e.g. 'Status email sent instead of a text' or the reason it was skipped."
    }
  },
  "required": [
    "order_id",
    "milestone",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}