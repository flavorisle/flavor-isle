{
  "name": "LoyaltyRedemption",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "loyalty_id": {
      "type": "string"
    },
    "discount_type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ]
    },
    "discount_value": {
      "type": "number"
    },
    "points_cost": {
      "type": "number"
    },
    "min_subtotal": {
      "type": "number",
      "default": 0
    },
    "description": {
      "type": "string"
    },
    "is_redeemed": {
      "type": "boolean",
      "default": false
    },
    "redeemed_at": {
      "type": "string",
      "format": "date-time"
    },
    "order_id": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "loyalty_id",
    "discount_type",
    "discount_value",
    "points_cost",
    "description"
  ]
}