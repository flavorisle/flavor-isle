{
  "name": "MerchProductAssignment",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "number",
      "description": "Printful sync product id this assignment maps to a category."
    },
    "product_name": {
      "type": "string",
      "description": "Snapshot of the Printful product name for reference in admin lists."
    },
    "category": {
      "type": "string",
      "description": "MerchCategory name this product is grouped under."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "product_id",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}