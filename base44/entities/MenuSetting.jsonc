{
  "name": "MenuSetting",
  "type": "object",
  "properties": {
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "hidden_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "category_sort_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "category_renames": {
      "type": "object",
      "description": "Map of category key -> display name shown to customers (e.g. { 'Burgers': 'Signature Burgers' }). Keys are the underlying Square/custom category; the label is what renders.",
      "default": {}
    },
    "category_item_order": {
      "type": "object",
      "description": "Map of category key -> ordered list of MenuItem ids controlling item order within that category on the public menu.",
      "default": {}
    },
    "ordering_enabled": {
      "type": "boolean",
      "default": true
    },
    "ordering_closed_message": {
      "type": "string",
      "default": "Ordering is temporarily closed"
    },
    "delivery_enabled": {
      "type": "boolean",
      "default": true,
      "description": "When false, delivery ordering is paused: the Delivery order type is unavailable to customers regardless of hours."
    },
    "closing_time": {
      "type": "string",
      "default": "20:00"
    },
    "delivery_cutoff_minutes": {
      "type": "number",
      "default": 30
    },
    "pickup_cutoff_minutes": {
      "type": "number",
      "default": 15
    },
    "delivery_fee": {
      "type": "number",
      "default": 0,
      "description": "Flat fee in USD applied to every delivery order. Set to 0 for free delivery."
    },
    "delivery_tiers": {
      "type": "array",
      "description": "Distance-based delivery pricing tiers, sorted by max_miles ascending. Each tier charges `fee` for addresses up to `max_miles` (straight-line) from the store. The last tier's max_miles is the delivery range limit \u2014 addresses beyond it are out of range. When empty, the flat delivery_fee applies instead.",
      "items": {
        "type": "object",
        "properties": {
          "max_miles": {
            "type": "number"
          },
          "fee": {
            "type": "number"
          }
        }
      },
      "default": []
    },
    "extra_cook_date": {
      "type": "string",
      "description": "YYYY-MM-DD (store local, America/Chicago). When today matches, the kitchen runs with an extra cook: order completion rate doubles, so quoted wait times shrink and busyness thresholds stretch. Auto-expires after the date passes."
    },
    "site_notice": {
      "type": "object",
      "description": "Toggleable site-wide notice banner shown to every visitor at the top of every page. Use to announce things like delivery pauses due to driver availability, limited staffing, or special holiday hours. When active is false the banner is hidden.",
      "properties": {
        "active": {
          "type": "boolean",
          "default": false
        },
        "message": {
          "type": "string",
          "description": "The text shown in the banner, e.g. 'Delivery is paused today \u2014 no driver available. Pickup is still open!'"
        },
        "level": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "urgent"
          ],
          "default": "warning",
          "description": "Visual tone of the banner: info (navy), warning (yellow), urgent (cherry red)."
        }
      }
    },
    "business_hours": {
      "type": "object",
      "description": "Per-day open hours keyed by weekday (monday..sunday), each with open, close (24h HH:MM) and closed flag",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "open": {
            "type": "string"
          },
          "close": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          }
        }
      }
    },
    "closure": {
      "type": "object",
      "description": "Temporary full-day closure override for maintenance, weather, or emergencies. When active and today (store local time, America/Chicago) falls within the inclusive start/end date range, the website shows a CLOSED banner, online ordering is cut off, and Smashie announces the closure on the phone.",
      "properties": {
        "active": {
          "type": "boolean",
          "default": false
        },
        "start_date": {
          "type": "string",
          "description": "YYYY-MM-DD inclusive, store local time (America/Chicago)"
        },
        "end_date": {
          "type": "string",
          "description": "YYYY-MM-DD inclusive, store local time (America/Chicago). Defaults to start_date for a single-day closure."
        },
        "message": {
          "type": "string",
          "description": "Reason shown to customers in the website banner and spoken by Smashie, e.g. 'closed for maintenance and the heat'."
        }
      }
    }
  },
  "required": [],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}