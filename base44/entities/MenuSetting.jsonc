{
  "name": "MenuSetting",
  "type": "object",
  "properties": {
    "hidden_categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "category_sort_order": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "ordering_enabled": {
      "type": "boolean",
      "default": true
    },
    "ordering_closed_message": {
      "type": "string",
      "default": "Ordering is temporarily closed"
    },
    "closing_time": {
      "type": "string",
      "default": "20:00"
    },
    "delivery_cutoff_minutes": {
      "type": "number",
      "default": 30
    },
    "pickup_cutoff_minutes": {
      "type": "number",
      "default": 15
    },
    "business_hours": {
      "type": "object",
      "description": "Per-day open hours keyed by weekday (monday..sunday), each with open, close (24h HH:MM) and closed flag",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "open": {
            "type": "string"
          },
          "close": {
            "type": "string"
          },
          "closed": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": []
}